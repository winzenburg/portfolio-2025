# === Newsletter Signup (Resend) ===
# Powers the "Get AI-Augmented Insights" newsletter form (client/src/components/NewsletterSignup.tsx)
# via the Netlify Function at netlify/functions/subscribe.ts. These two are also
# set as Netlify site environment variables (netlify env:set), since Netlify
# Functions don't read this local .env file.
#
# 1. Get your API key at: https://resend.com/api-keys
# 2. Create an Audience at: https://resend.com/audiences and copy its ID
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_AUDIENCE_ID=your-audience-id-here

# === Weekly AI-Native Scan Subscription (Resend) ===
# Powers the /subscribe page and the Netlify Function at
# netlify/functions/subscribe-weekly-scan.ts.
#
# RESEND_API_KEY (above) is shared — the same key is used for the weekly scan function.
#
# Segment and Topic IDs default to the values below if the env vars are unset.
# Set them explicitly in Netlify site settings to override.
#
# Segment: "Weekly AI-Native Improvement Scan"
RESEND_WEEKLY_SCAN_SEGMENT_ID=1c45d141-2cfa-40bc-b78d-e3c838ef5164
#
# Topic: "Weekly AI-Native Scan" (opt_in default)
RESEND_WEEKLY_SCAN_TOPIC_ID=5228eb84-30e6-4af9-a6f1-808387c8e58c
#
# Sender address used for the welcome email. Must be on a verified domain in Resend.
RESEND_FROM="Ryan Winzenburg <hello@winzenburg.com>"

# === New Article Notifications (Resend Broadcasts) ===
# Powers scripts/notify-subscribers.js, which emails everyone in RESEND_AUDIENCE_ID
# whenever a new article is published (see ARTICLES_WORKFLOW.md, step 6).
#
# NEWSLETTER_RESEND_API_KEY is deliberately separate from RESEND_API_KEY above:
# this project also runs unrelated LinkedIn content automation scripts that
# read RESEND_API_KEY for a different Resend account. Use the key from the
# account that owns RESEND_AUDIENCE_ID here so the two never collide.
NEWSLETTER_RESEND_API_KEY=re_xxxxxxxxxxxxx
#
# Must be an address on a domain you've verified in Resend (Domains tab) -
# unverified/resend.dev senders cannot broadcast to a full audience.
NEWSLETTER_FROM_EMAIL="Ryan Winzenburg <newsletter@winzenburg.com>"

# LinkedIn Content Automation - Email Configuration
# Copy this file to .env and fill in your credentials

# Email recipient (where to send LinkedIn content notifications)
EMAIL_TO=ryanwinzenburg@gmail.com

# Email sender (optional, defaults to noreply@localhost)
EMAIL_FROM="LinkedIn Content Bot <noreply@localhost>"

# === Option 1: Gmail SMTP (Recommended) ===
# To use Gmail:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Create an app password for "Mail"
# 3. Copy the 16-character password below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ryanwinzenburg@gmail.com
SMTP_PASSWORD=your-app-specific-password-here

# === Option 2: Other SMTP Provider ===
# Uncomment and configure if using a different email provider
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password

# === Option 3: macOS Mail Command ===
# Leave SMTP_PASSWORD empty to use macOS built-in mail command
# Note: Requires Mail.app to be configured with an account
